#!/bin/bash
# vs-profile — isolated mod/save profiles for Vintage Story
#
# Each profile is a full data directory (its own Mods, Saves, ModConfig,
# keybinds), so mod sets for different servers never collide.
#
# Profiles live in ~/.config/VintagestoryData-<name>.
# Game installs are expected at ~/games/vintagestory-<version>.

set -euo pipefail

GAMES_DIR="${VS_PROFILE_GAMES_DIR:-$HOME/games}"
DEFAULT_VERSION="${VS_PROFILE_DEFAULT_VERSION:-}"
SYNC_WAIT_SECS="${VS_PROFILE_SYNC_WAIT:-180}"

profile_dir() { echo "$HOME/.config/VintagestoryData-$1"; }
die() { echo "vs-profile: $*" >&2; exit 1; }

usage() {
    cat <<'EOF'
vs-profile — isolated mod/save profiles for Vintage Story

  vs-profile <name> [game args...]  launch a profile, creating it if new
  vs-profile list                   profiles with mod/save counts and sync state
  vs-profile mods <name>            list a profile's mods
  vs-profile path <name>            print a profile's data directory
  vs-profile pin <name> <ver>       always launch this profile on game <ver>
  vs-profile unpin <name>           go back to the newest installed version
  vs-profile sync <name>            move a profile into your cloud folder
  vs-profile unsync <name>          move it back to local disk
  vs-profile update <name>          update its mods from ModDB; check for a new game
  vs-profile install [<ver>]        install a game version from the CDN

Options
  -g, --game-version <ver>  launch a specific game version (overrides a pin)
  -f, --force               launch even if another machine holds the sync lock
  -n, --dry-run             update: report what would change, download nothing
      --game                update: also install a new game version if one is out
  -h, --help                this help

Environment
  VS_PROFILE_SYNC_DIR    cloud folder to sync into (default: auto-detect Dropbox)
  VS_PROFILE_GAMES_DIR   where game installs live (default: ~/games)
  VS_PROFILE_SYNC_WAIT   seconds to wait for sync before launching (default: 180)
  VS_PROFILE_STABLE_API  game release index (default: api.vintagestory.at)
  VS_PROFILE_MODDB_API   mod database API (default: mods.vintagestory.at/api)
EOF
}

# ---------------------------------------------------------------- versions ---

list_versions() {
    for d in "$GAMES_DIR"/vintagestory-*/; do
        [ -d "$d" ] || continue
        basename "$d" | sed 's/^vintagestory-//'
    done | sort -V
}

newest_version() { list_versions | tail -1; }

have_version() { [ -x "$GAMES_DIR/vintagestory-$1/Vintagestory" ]; }

# A pinned version lives in the profile, not in this script's config, so it
# travels with a synced profile and survives a reinstall. Servers pin their
# game version and reject mismatched clients, so "newest installed" is the
# wrong default for a server profile — and can even be an older release than
# the newest one you have.
pin_file() { echo "$(readlink -f "$(profile_dir "$1")")/.vs-profile-gameversion"; }

read_pin() {
    local f
    f=$(pin_file "$1")
    [ -f "$f" ] || return 0
    head -1 "$f" | tr -d '[:space:]'
}

cmd_pin() {
    local name="$1" version="$2"
    [ -d "$(profile_dir "$name")" ] || die "no such profile: $name"
    have_version "$version" || \
        die "game version $version not installed (have: $(list_versions | tr '\n' ' '))"
    echo "$version" > "$(pin_file "$name")"
    echo "vs-profile: '$name' pinned to game $version"
}

cmd_unpin() {
    local name="$1" f
    [ -d "$(profile_dir "$name")" ] || die "no such profile: $name"
    f=$(pin_file "$name")
    [ -f "$f" ] || die "profile '$name' is not pinned"
    rm "$f"
    echo "vs-profile: '$name' unpinned; will use the newest installed version"
}

# -------------------------------------------------------------------- sync ---

# Root of the local cloud folder, or empty if none found.
sync_root() {
    if [ -n "${VS_PROFILE_SYNC_DIR:-}" ]; then echo "$VS_PROFILE_SYNC_DIR"; return; fi
    if [ -f "$HOME/.dropbox/info.json" ]; then
        local p
        p=$(python3 -c "
import json
try:
    d=json.load(open('$HOME/.dropbox/info.json'))
    for k in ('personal','business'):
        if k in d and d[k].get('path'):
            print(d[k]['path']); break
except Exception: pass
" 2>/dev/null || true)
        [ -n "$p" ] && { echo "$p"; return; }
    fi
    [ -d "$HOME/Dropbox" ] && echo "$HOME/Dropbox"
    return 0
}

is_synced() { [ -L "$(profile_dir "$1")" ]; }

# Block until the cloud client reports idle, so we never open a save mid-download.
wait_for_sync() {
    command -v dropbox >/dev/null 2>&1 || return 0
    local status waited=0
    status=$(dropbox status 2>/dev/null | head -1 || true)
    case "$status" in
        "Up to date"|"") return 0 ;;
        *"isn't running"*|*"not running"*)
            echo "vs-profile: warning — Dropbox is not running; the profile may be stale" >&2
            return 0 ;;
    esac
    echo "vs-profile: waiting for Dropbox to finish syncing ($status)"
    while [ "$waited" -lt "$SYNC_WAIT_SECS" ]; do
        sleep 2; waited=$((waited+2))
        status=$(dropbox status 2>/dev/null | head -1 || true)
        [ "$status" = "Up to date" ] && { echo "vs-profile: sync complete"; return 0; }
    done
    echo "vs-profile: warning — still syncing after ${SYNC_WAIT_SECS}s, launching anyway" >&2
}

# A synced profile opened on two machines at once corrupts the save database.
LOCK=""
claim_lock() {
    local data="$1" force="$2" host
    LOCK="$data/.vs-profile-lock"
    if [ -f "$LOCK" ]; then
        host=$(head -1 "$LOCK" 2>/dev/null || true)
        if [ -n "$host" ] && [ "$host" != "$(hostname)" ]; then
            if [ "$force" != "yes" ]; then
                echo "vs-profile: profile is locked by '$host'." >&2
                echo "  Running it on two machines at once will corrupt the save." >&2
                echo "  If that machine is closed, clear it with: rm '$LOCK'" >&2
                echo "  Or override with: vs-profile -f <name>" >&2
                exit 1
            fi
            echo "vs-profile: overriding lock held by '$host'" >&2
        fi
    fi
    { hostname; date -u +%Y-%m-%dT%H:%M:%SZ; } > "$LOCK"
    trap 'rm -f "$LOCK"' EXIT INT TERM
}

cmd_sync() {
    local name="$1" root src dst
    src=$(profile_dir "$name")
    [ -d "$src" ] || die "no such profile: $name"
    is_synced "$name" && die "profile '$name' is already synced (-> $(readlink "$src"))"
    root=$(sync_root)
    [ -n "$root" ] || die "no cloud folder found; set VS_PROFILE_SYNC_DIR"
    [ -d "$root" ] || die "cloud folder does not exist: $root"
    dst="$root/VintageStory/$name"
    [ -e "$dst" ] && die "destination already exists: $dst"
    mkdir -p "$root/VintageStory"
    echo "vs-profile: moving $src -> $dst"
    mv "$src" "$dst"
    ln -s "$dst" "$src"
    echo "vs-profile: '$name' now syncs via $dst"
    echo
    echo "  Do NOT exclude Logs/Cache/Backups from selective sync — the game"
    echo "  recreates them each launch and the sync client will fight it."
    echo "  Do NOT run this profile on two machines at once; saves are databases."
}

cmd_unsync() {
    local name="$1" src target
    src=$(profile_dir "$name")
    is_synced "$name" || die "profile '$name' is not synced"
    target=$(readlink -f "$src")
    rm "$src"
    echo "vs-profile: moving $target -> $src"
    mv "$target" "$src"
    echo "vs-profile: '$name' is now local only"
}

# ----------------------------------------------------------------- listing ---

count_glob() { local n=0 f; for f in "$@"; do [ -e "$f" ] && n=$((n+1)); done; echo "$n"; }

print_row() {
    local d="$1" label="$2" sync="$3" pinned="$4"
    printf '%-16s %-6s %-6s %-7s %-8s %s\n' "$label" \
        "$(count_glob "$d"/Mods/*.zip "$d"/Mods/*.cs "$d"/Mods/*.dll)" \
        "$(count_glob "$d"/Saves/*.vcdbs)" "$sync" "${pinned:--}" "$d"
}

cmd_list() {
    local d name root
    printf '%-16s %-6s %-6s %-7s %-8s %s\n' PROFILE MODS SAVES SYNCED PINNED PATH
    for d in "$HOME"/.config/VintagestoryData-*/; do
        [ -d "$d" ] || continue
        name=$(basename "${d%/}" | sed 's/^VintagestoryData-//')
        if is_synced "$name"; then
            print_row "$(readlink -f "${d%/}")" "$name" "yes" "$(read_pin "$name")"
        else
            print_row "${d%/}" "$name" "no" "$(read_pin "$name")"
        fi
    done
    echo
    echo "Installed versions: $(list_versions | tr '\n' ' ')"
    root=$(sync_root)
    [ -n "$root" ] && echo "Cloud folder: $root"
    return 0
}

# --------------------------------------------------------------- launching ---

# Vintage Story reads mod folders from "modPaths" in clientsettings.json, NOT
# from --dataPath. A settings file copied from another profile carries that
# profile's absolute Mods path and silently wins, so pin it on every launch.
repair_mod_paths() {
    python3 - "$1" <<'PY' || true
import json, os, sys
prof = sys.argv[1]
cs = os.path.join(prof, 'clientsettings.json')
if not os.path.isfile(cs): sys.exit(0)
try:
    with open(cs) as f: d = json.load(f)
except Exception: sys.exit(0)
sl = d.get('stringListSettings')
if not isinstance(sl, dict): sys.exit(0)
want = ['Mods', os.path.join(os.path.realpath(prof), 'Mods')]
if sl.get('modPaths') != want:
    sl['modPaths'] = want
    tmp = cs + '.tmp'
    with open(tmp, 'w') as f: json.dump(d, f, indent=1)
    os.replace(tmp, cs)
    print(f"vs-profile: repaired modPaths -> {want[1]}")
PY
}

# ----------------------------------------------------------------- updating ---

STABLE_API="${VS_PROFILE_STABLE_API:-https://api.vintagestory.at/stable.json}"
MODDB_API="${VS_PROFILE_MODDB_API:-https://mods.vintagestory.at/api}"

# "<version> <url> <md5>" for one release, or for the newest stable one.
stable_info() {
    python3 - "$STABLE_API" "${1:-}" <<'PY'
import json, re, sys, urllib.request
api, want = sys.argv[1], sys.argv[2]
req = urllib.request.Request(api, headers={'User-Agent': 'vs-profile'})
try:
    with urllib.request.urlopen(req, timeout=30) as r:
        data = json.load(r)
except Exception as e:
    sys.exit(f"cannot reach {api}: {e}")
best = None
for ver, platforms in data.items():
    if not re.fullmatch(r'\d+\.\d+\.\d+', ver):
        continue
    if want and ver != want:
        continue
    linux = platforms.get('linux') or {}
    urls = linux.get('urls') or {}
    url = urls.get('cdn') or urls.get('local')
    if not url:
        continue
    key = [int(x) for x in ver.split('.')]
    if best is None or key > best[0]:
        best = (key, ver, url, linux.get('md5') or '-')
if best is None:
    sys.exit(f"no linux build for {want}" if want else "no stable release listed")
print(best[1], best[2], best[3])
PY
}

# 1.22+ needs the .NET 10 runtime at ~/.dotnet; the shipped run.sh uses whatever
# dotnet is on PATH, which on most distros is an older one that just fails.
add_dotnet_export() {
    local dir="$1" version="$2" f
    case "$version" in 1.21.*|1.20.*|1.19.*) return 0 ;; esac
    [ -d "$HOME/.dotnet" ] || return 0
    for f in "$dir/run.sh" "$dir/server.sh"; do
        [ -f "$f" ] || continue
        if grep -q DOTNET_ROOT "$f"; then continue; fi
        python3 - "$f" "$version" <<'PY'
import sys
path, version = sys.argv[1], sys.argv[2]
lines = open(path).read().splitlines(True)
at = 1 if lines and lines[0].startswith('#!') else 0
lines[at:at] = [f'\n# {version} needs the .NET 10 runtime (the system one is often older)\n',
                'export DOTNET_ROOT="$HOME/.dotnet"\n',
                'export PATH="$DOTNET_ROOT:$PATH"\n']
open(path, 'w').write(''.join(lines))
PY
    done
    return 0
}

# The client tarball unpacks into a nested vintagestory/ directory, so it cannot
# just be extracted into place — flatten it into a versioned install dir.
cmd_install() {
    local want="${1:-}" info version url md5 dest tmp got src
    info=$(stable_info "$want") || exit 1
    read -r version url md5 <<<"$info"
    dest="$GAMES_DIR/vintagestory-$version"
    if [ -e "$dest" ]; then
        echo "vs-profile: game $version is already installed at $dest"
        return 0
    fi
    mkdir -p "$GAMES_DIR"
    # Unpack next to the installs so the final move is a rename, not a 2GB copy.
    tmp=$(mktemp -d "$GAMES_DIR/.vs-profile-install.XXXXXX")
    echo "vs-profile: downloading game $version"
    if ! curl -fL --progress-bar -o "$tmp/client.tar.gz" "$url"; then
        rm -rf "$tmp"; die "download failed: $url"
    fi
    if [ "$md5" != "-" ] && command -v md5sum >/dev/null 2>&1; then
        got=$(md5sum "$tmp/client.tar.gz" | cut -d' ' -f1)
        if [ "$got" != "$md5" ]; then
            rm -rf "$tmp"; die "checksum mismatch for $version (got $got, expected $md5)"
        fi
    fi
    mkdir -p "$tmp/unpack"
    if ! tar xzf "$tmp/client.tar.gz" -C "$tmp/unpack"; then
        rm -rf "$tmp"; die "could not unpack the $version tarball"
    fi
    src="$tmp/unpack/vintagestory"
    [ -d "$src" ] || src="$tmp/unpack"
    if [ ! -f "$src/Vintagestory" ]; then
        rm -rf "$tmp"; die "unexpected tarball layout: no Vintagestory binary in $src"
    fi
    mv "$src" "$dest"
    rm -rf "$tmp"
    chmod +x "$dest/Vintagestory" "$dest/VintagestoryServer" \
             "$dest/run.sh" "$dest/server.sh" 2>/dev/null || true
    add_dotnet_export "$dest" "$version"
    echo "vs-profile: installed game $version at $dest"
    # Some setups keep a ~/games/vintagestory symlink on the newest install;
    # follow it along, but never create one that was not already there.
    if [ -L "$GAMES_DIR/vintagestory" ] && [ "$version" = "$(newest_version)" ]; then
        ln -sfn "vintagestory-$version" "$GAMES_DIR/vintagestory"
        echo "vs-profile: $GAMES_DIR/vintagestory -> vintagestory-$version"
    fi
    return 0
}

# Mods are matched to the game version the profile actually launches on, which
# is the pin if it has one — a server profile must not be dragged forward.
update_mods() {
    python3 - "$1" "$2" "$3" "$MODDB_API" <<'PY'
import json, os, re, sys, tempfile, urllib.request, zipfile

data, target, dry, api = sys.argv[1], sys.argv[2], sys.argv[3] == 'yes', sys.argv[4]
mods_dir = os.path.join(data, 'Mods')
backup_dir = os.path.join(data, '.vs-profile-oldmods')
UA = {'User-Agent': 'vs-profile'}

def get(url, binary=False):
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=60) as r:
        return r.read() if binary else json.load(r)

# modinfo.json is hand-written and routinely has comments, trailing commas or
# stray control characters in it, so a plain json.loads is not enough.
def read_modinfo(path):
    try:
        with zipfile.ZipFile(path) as z:
            names = [n for n in z.namelist()
                     if n.lower() == 'modinfo.json' or n.lower().endswith('/modinfo.json')]
            if not names:
                return None
            raw = z.read(sorted(names, key=len)[0]).decode('utf-8-sig', 'replace')
    except Exception:
        return None
    txt = re.sub(r'(?m)//[^\n"]*$', '', raw)
    txt = re.sub(r',(\s*[}\]])', r'\1', txt)
    txt = ''.join(c for c in txt if c >= ' ' or c in '\t\n\r')
    try:
        return {k.lower(): v for k, v in json.loads(txt).items()}
    except Exception:
        return None

def vkey(v):
    s = str(v).lstrip('vV')
    nums = [int(n) for n in re.findall(r'\d+', s.split('-')[0])]
    return (nums, 0 if '-' in s else 1, s)   # 1.2.0-rc.1 sorts below 1.2.0

def branch(v):
    return tuple(re.findall(r'\d+', v)[:2])

tb = branch(target)
zips = sorted(f for f in os.listdir(mods_dir) if f.lower().endswith('.zip')) \
       if os.path.isdir(mods_dir) else []
loose = sorted(f for f in os.listdir(mods_dir)
               if f.lower().endswith(('.cs', '.dll'))) if os.path.isdir(mods_dir) else []

plan, current, notes = [], 0, []
for name in zips:
    path = os.path.join(mods_dir, name)
    info = read_modinfo(path)
    if not info or not info.get('modid') or not info.get('version'):
        notes.append(f"{name}: no readable modinfo.json, skipped")
        continue
    modid, cur = str(info['modid']), str(info['version'])
    try:
        mod = (get(f"{api}/mod/{modid}") or {}).get('mod')
    except Exception as e:
        notes.append(f"{modid}: ModDB lookup failed ({e})")
        continue
    if not mod:
        notes.append(f"{modid}: not found on ModDB, skipped")
        continue
    releases = [r for r in mod.get('releases', []) if r.get('modversion') and r.get('mainfile')]
    exact = [r for r in releases if target in (r.get('tags') or [])]
    # Authors often stop re-tagging a working mod, so a release tagged for an
    # earlier 1.22.x is still the right pick on 1.22.7 — flag it, do not skip it.
    same = [r for r in releases
            if any('-' not in t and branch(t) == tb for t in (r.get('tags') or []))]
    pool = exact or same
    if not pool:
        notes.append(f"{modid} {cur}: no release tagged for game {'.'.join(tb)}.x")
        continue
    # An rc is not an upgrade for someone who is on a stable release, so it is
    # only offered when the mod has nothing stable to offer at all.
    stable = [r for r in pool if '-' not in str(r['modversion'])]
    best = max(stable or pool, key=lambda r: vkey(r['modversion']))
    if vkey(best['modversion']) <= vkey(cur):
        current += 1
        continue
    # Say which way the tag misses: a release that stopped being re-tagged is a
    # different risk from one built against a patch newer than this profile runs.
    lag = ''
    if not exact:
        top = max([t for t in (best.get('tags') or []) if '-' not in t and branch(t) == tb],
                  key=vkey)
        lag = (f"  (tagged up to {top}, you run {target})" if vkey(top) < vkey(target)
               else f"  (tagged for {top}, newer than {target})")
    if not stable:
        lag += '  (prerelease)'
    plan.append({'modid': modid, 'file': name, 'from': cur, 'to': best['modversion'],
                 'url': best['mainfile'],
                 'newfile': best.get('filename') or f"{modid}_{best['modversion']}.zip",
                 'lag': lag})

for n in notes:
    print(f"  note: {n}")
for m in loose:
    print(f"  note: {m}: loose .cs/.dll mod, not tracked on ModDB")

skipped = len(notes) + len(loose)
tail = f", {skipped} skipped" if skipped else ""
if not plan:
    print(f"mods:  {current} up to date for game {target}{tail}")
    sys.exit(0)

print(f"mods:  {len(plan)} update(s) for game {target}, {current} already current{tail}")
for p in plan:
    print(f"       {p['modid']}  {p['from']} -> {p['to']}{p['lag']}")
if dry:
    print("       (dry run, nothing downloaded)")
    sys.exit(0)

os.makedirs(backup_dir, exist_ok=True)
failed = 0
for p in plan:
    try:
        blob = get(p['url'], binary=True)
    except Exception as e:
        print(f"       {p['modid']}: download failed ({e})"); failed += 1; continue
    fd, tmp = tempfile.mkstemp(dir=mods_dir, suffix='.part')
    with os.fdopen(fd, 'wb') as f:
        f.write(blob)
    got = read_modinfo(tmp)
    # A ModDB mainfile can redirect to an HTML error page; only a zip whose
    # modinfo matches what we asked for is allowed to replace a working mod.
    if not got or str(got.get('modid', '')).lower() != p['modid'].lower():
        os.unlink(tmp)
        print(f"       {p['modid']}: downloaded file is not that mod, skipped"); failed += 1
        continue
    # Keep one generation of backups so a synced profile does not accumulate
    # every zip it has ever had.
    for old in os.listdir(backup_dir):
        if old.startswith(p['modid'] + '__'):
            os.unlink(os.path.join(backup_dir, old))
    os.replace(os.path.join(mods_dir, p['file']),
               os.path.join(backup_dir, f"{p['modid']}__{p['file']}"))
    os.replace(tmp, os.path.join(mods_dir, p['newfile']))
    os.chmod(os.path.join(mods_dir, p['newfile']), 0o644)
    print(f"       {p['modid']} -> {p['to']}  ({p['newfile']})")

print(f"       previous versions kept in {backup_dir}")
sys.exit(1 if failed else 0)
PY
}

cmd_update() {
    local name="" dry=no want_game=no data pin target info latest url md5
    while [ $# -gt 0 ]; do
        case "$1" in
            -n|--dry-run) dry=yes; shift ;;
            --game)       want_game=yes; shift ;;
            -*)           die "unknown option for update: $1" ;;
            *)            [ -z "$name" ] || die "usage: vs-profile update <name> [--dry-run] [--game]"
                          name="$1"; shift ;;
        esac
    done
    [ -n "$name" ] || die "usage: vs-profile update <name> [--dry-run] [--game]"
    data=$(readlink -f "$(profile_dir "$name")")
    [ -d "$data" ] || die "no such profile: $name"
    if command -v pgrep >/dev/null 2>&1 && pgrep -f "dataPath=$data" >/dev/null 2>&1; then
        die "the game is running on '$name'; quit it before updating its mods"
    fi
    pin=$(read_pin "$name")

    # The game first: on an unpinned profile a fresh install moves the target
    # the mods have to match, so it has to be settled before they are picked.
    if info=$(stable_info); then
        read -r latest url md5 <<<"$info"
        if have_version "$latest"; then
            echo "game:  $latest is the newest stable release and is installed"
        elif [ "$want_game" = yes ] && [ "$dry" = no ]; then
            cmd_install "$latest"
        else
            echo "game:  $latest is available (installed: $(list_versions | tr '\n' ' '))"
            echo "       'vs-profile update $name --game' downloads and installs it"
        fi
    else
        echo "game:  version check failed; carrying on with the mods" >&2
    fi

    target="${VERSION_ARG:-${pin:-$(newest_version)}}"
    [ -n "$target" ] || die "no game installs found in $GAMES_DIR"
    have_version "$target" || die "game version $target is not installed in $GAMES_DIR"
    # A pinned profile is usually a server profile, and a server checks the mod
    # list it is handed — updating one half of that pair locks you out.
    if [ -n "$pin" ]; then
        echo "       '$name' is pinned to $pin, so its mods are matched to that;"
        echo "       if it is a server profile, update only when the server does"
    fi
    update_mods "$data" "$target" "$dry"
}

# -------------------------------------------------------------------- main ---

FORCE=no
VERSION_ARG=""
while [ $# -gt 0 ]; do
    case "$1" in
        -g|--game-version) VERSION_ARG="${2:-}"; shift 2 ;;
        -f|--force)        FORCE=yes; shift ;;
        -h|--help)         usage; exit 0 ;;
        --)                shift; break ;;
        *)                 break ;;
    esac
done

[ $# -ge 1 ] || { usage; exit 1; }

case "$1" in
    list|ls) cmd_list; exit 0 ;;
    path)    [ $# -ge 2 ] || die "usage: vs-profile path <name>"
             profile_dir "$2"; exit 0 ;;
    mods)    [ $# -ge 2 ] || die "usage: vs-profile mods <name>"
             DIR=$(readlink -f "$(profile_dir "$2")")
             [ -d "$DIR" ] || die "no such profile: $2"
             ls -1 "$DIR/Mods" 2>/dev/null || echo "(no mods)"
             exit 0 ;;
    pin)     [ $# -ge 3 ] || die "usage: vs-profile pin <name> <game-version>"
             cmd_pin "$2" "$3"; exit 0 ;;
    unpin)   [ $# -ge 2 ] || die "usage: vs-profile unpin <name>"
             cmd_unpin "$2"; exit 0 ;;
    sync)    [ $# -ge 2 ] || die "usage: vs-profile sync <name>"
             cmd_sync "$2"; exit 0 ;;
    unsync)  [ $# -ge 2 ] || die "usage: vs-profile unsync <name>"
             cmd_unsync "$2"; exit 0 ;;
    update)  shift; cmd_update "$@"; exit $? ;;
    install) cmd_install "${2:-}"; exit 0 ;;
esac

NAME="$1"; shift
case "$NAME" in */*|.|..) die "invalid profile name: $NAME" ;; esac

DATA=$(profile_dir "$NAME")
if [ ! -e "$DATA" ]; then
    echo "vs-profile: creating new profile '$NAME' at $DATA"
    mkdir -p "$DATA/Mods"
    # Seed keybinds/graphics from an existing profile so new ones aren't bare.
    # repair_mod_paths below undoes the mod path this drags along.
    for seed in "$HOME"/.config/VintagestoryData-*/ "$HOME/.config/VintagestoryData"; do
        [ -f "$seed/clientsettings.json" ] || continue
        [ "$(readlink -f "$seed")" = "$(readlink -f "$DATA")" ] && continue
        cp "$seed/clientsettings.json" "$DATA/clientsettings.json"; break
    done
    echo "vs-profile: drop mod .zip files into $DATA/Mods"
fi
mkdir -p "$DATA/Mods"

# -g wins, then the profile's own pin, then the newest install.
PIN=$(read_pin "$NAME")
VERSION="${VERSION_ARG:-${PIN:-${DEFAULT_VERSION:-$(newest_version)}}}"
[ -n "$VERSION" ] || die "no game installs found in $GAMES_DIR"
if ! have_version "$VERSION"; then
    if [ -n "$PIN" ] && [ "$VERSION" = "$PIN" ]; then
        die "'$NAME' is pinned to game $PIN, which is not installed in $GAMES_DIR
  (have: $(list_versions | tr '\n' ' '))
  Install it, or override with: vs-profile -g <ver> $NAME
  Or drop the pin with: vs-profile unpin $NAME"
    fi
    die "game version $VERSION not found at $GAMES_DIR/vintagestory-$VERSION (have: $(list_versions | tr '\n' ' '))"
fi
GAME="$GAMES_DIR/vintagestory-$VERSION"
if [ -n "$PIN" ]; then
    if [ "$VERSION" = "$PIN" ]; then
        echo "vs-profile: '$NAME' is pinned to game $VERSION"
    else
        echo "vs-profile: using game $VERSION, overriding the $PIN pin on '$NAME'"
    fi
fi

if is_synced "$NAME"; then
    wait_for_sync
    claim_lock "$(readlink -f "$DATA")" "$FORCE"
fi

repair_mod_paths "$DATA"

# 1.22+ needs the .NET 10 runtime at ~/.dotnet; 1.21 and older use system .NET
case "$VERSION" in
    1.21.*|1.20.*|1.19.*) ;;
    *) if [ -d "$HOME/.dotnet" ]; then
           export DOTNET_ROOT="$HOME/.dotnet"
           export PATH="$DOTNET_ROOT:$PATH"
       fi ;;
esac

export FONTCONFIG_FILE="$GAME/fonts.conf"
cd "$GAME"
./Vintagestory --dataPath="$DATA" "$@"

# Give the cloud client a moment to push the save before we exit, so
# "quit game, close laptop" doesn't strand an unsynced world.
if is_synced "$NAME" && command -v dropbox >/dev/null 2>&1; then
    rm -f "$LOCK"; LOCK=""
    trap - EXIT INT TERM
    echo "vs-profile: waiting for Dropbox to upload the save..."
    wait_for_sync
fi
